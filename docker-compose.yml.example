services:
  auto-sign-in:
    build: .
    container_name: auto-sign-in
    env_file:
      - .env                      # 加载第一份环境变量
    volumes:
      - ./.env:/app/config.env:ro
      # 持久化会话文件和去重标记，重建容器后不用重新登录
      - ./state/auto-sign-in:/app/state
    environment:
      - TZ=Asia/Shanghai
      - CRON_SCHEDULE=11 9 * * *
      - RUN_ON_STARTUP=false
    logging:
      driver: json-file
      options:
        max-size: "50m"
        max-file: "3"
    restart: always
