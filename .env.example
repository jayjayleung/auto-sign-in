# 墨天轮（墨道 DB）
MODB_USERNAME=
MODB_PASSWORD=

# TiDB 社区。TIDB_LOGIN_MODE 可选 password（默认）或 cookie
TIDB_LOGIN_MODE=password
TIDB_USERNAME=
TIDB_PASSWORD=
# cookie 模式填写浏览器完成登录后的 Cookie，需包含 csrftoken 和 ssid
TIDB_COOKIE=

# 永洪社区
YH_USERNAME=
YH_PASSWORD=

# 云桥积分中心（单账号使用无序号；多账号使用 _1、_2，_1 优先于无序号）
YUNQIAO_USERNAME=
YUNQIAO_PASSWORD=
YUNQIAO_USERNAME_1=
YUNQIAO_PASSWORD_1=
YUNQIAO_USERNAME_2=
YUNQIAO_PASSWORD_2=

# 观猹任务中心（https://watcha.cn/quest，账号填写邮箱或手机号）
WATCHA_USERNAME=
WATCHA_PASSWORD=
# true 或 1 开启自动发猹评和帖子，还需要配齐下面的文案接口。留空、false、0 则只签到
WATCHA_PUBLISH=false

# 文案接口（兼容 OpenAI 对话接口）。地址填到版本前缀，例如 https://api.openai.com/v1
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# 邮件通知（EMAIL_PASSWORD 填写 SMTP 密码或授权码）
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_TO=

# 微信通知（按需配置 PushPlus 或 Server酱）
PUSH_PLUS_TOKEN=
SERVER_CHAN_TOKEN=
