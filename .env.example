# 墨天轮（墨道 DB）
MODB_USERNAME=
MODB_PASSWORD=
# 可选：状态目录覆盖。默认落 /app/state（本地运行退系统临时目录），一般不用填
# MODB_STATE_DIR=

# TiDB 社区。TIDB_LOGIN_MODE 可选 password（默认）或 cookie
TIDB_LOGIN_MODE=password
TIDB_USERNAME=
TIDB_PASSWORD=
# cookie 模式填写浏览器完成登录后的 Cookie，需包含 csrftoken 和 ssid
TIDB_COOKIE=

# 永洪社区
YH_USERNAME=
YH_PASSWORD=

# 云桥积分中心（单账号使用无序号；多账号使用 _1、_2，_1 优先于无序号）
YUNQIAO_USERNAME=
YUNQIAO_PASSWORD=
YUNQIAO_USERNAME_1=
YUNQIAO_PASSWORD_1=
YUNQIAO_USERNAME_2=
YUNQIAO_PASSWORD_2=

# 观猹任务中心（https://watcha.cn/quest，账号填写邮箱或手机号）
WATCHA_USERNAME=
WATCHA_PASSWORD=
# 在签到通知里列出当日推荐产品和体验入口，由本人体验后手写猹评，默认开启。只做提醒，不自动发布
WATCHA_AUTO_REVIEW=true
# 自动发讨论帖，默认关闭，需要 AI_BASE_URL、AI_API_KEY、AI_MODEL
WATCHA_PUBLISH_POST=false
# 自动写猹评并偶发回评，默认关闭。打开后每天最多 1 条，挑一个还没评过的推荐产品，
# 真打开一次官网采集事实，再按实测分布抽出来的形状成稿并提交。
# 需要 AI_BASE_URL、AI_API_KEY、AI_MODEL；打开后不再推送猹评提醒
WATCHA_PUBLISH_REVIEW=false
# 以下都是可选覆盖，不填就用实测默认值（省略号处是默认）：
# WATCHA_REVIEW_QUIET_WEEK_RATE=0.3  整周几乎不写的概率（活跃周 5-6 天、静默周 0-1 天，约每周 4 条）
# WATCHA_REVIEW_DELAY_MINUTES=25  提交前随机等待上限
# WATCHA_REPLY_RATE=0.3           回评概率
# WATCHA_REPLY_DELAY_MINUTES=8    回评前随机等待上限
# WATCHA_JITTER_MINUTES=20        开跑随机延后上限（开了自动发布时）
# WATCHA_REVIEW_DRY_RUN=false     试运行，只打成稿不提交
# WATCHA_REVIEW_SHOT=false        配图改用试用截图（只要浏览器模式；图直接传进观猹自己的存储）
# WATCHA_SHOT_HOST=               可选：外部图床地址，站内直传失败时才用
# WATCHA_REVIEW_OFF_QUEST_RATE=0.15  不写推荐产品、改挑普通产品的概率
# WATCHA_REVIEW_PERSONA=medium    账号人格：short（短评型）/ medium（默认，接近本账号历史）/ long（长评型）
# 用真浏览器登录并提交。开了以后 TLS 指纹、会话 cookie、页面埋点三样都对得上，
# 代价是每次运行多起一次 Chrome（镜像里已装依赖），首次会下载浏览器
WATCHA_BROWSER=false
# 旧开关，作为上面两个的后备值：WATCHA_PUBLISH 管帖子，WATCHA_REVIEW_REMINDER 管猹评提醒
WATCHA_PUBLISH=false

# 西门子工业支持中心（https://www.ad.siemens.com.cn/MySupport/index.aspx，账号填用户名、手机号或邮箱）
SIEMENS_USERNAME=
SIEMENS_PASSWORD=
# 总开关，默认开启。设为 false 时整个西门子签到（含每日任务）都不执行，通知里也不出现这一组
SIEMENS_ENABLED=true
# 设为 false 时只签到，不执行收藏、发帖、评论等每日任务
SIEMENS_DAILY_TASKS=
# 故事帖开关，默认开启。故事帖要站点人工审核，AI 生成内容常被判「非原创」驳回，
# 想彻底不投故事帖时设为 false，其余每日任务照常执行
SIEMENS_STORY_POST=true

# 文案接口（需支持 Chat Completions）。地址填到版本前缀，例如 https://api.openai.com/v1
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# 主模型超时或报错时，第二次改用这个模型生成文案；留空则仍用主模型
AI_FALLBACK_MODEL=
# 产品资料默认由程序直接查 Bing；服务能真正执行原生 web_search 时可设 true 改用 Responses 检索
AI_NATIVE_SEARCH=false

# 邮件通知（EMAIL_PASSWORD 填写 SMTP 密码或授权码）
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_TO=

# 微信通知（按需配置 PushPlus 或 Server酱）
PUSH_PLUS_TOKEN=
SERVER_CHAN_TOKEN=
